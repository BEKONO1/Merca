{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile",
    "context": ".",
    "dockerfile": "Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "healthcheckPath": "/",
    "healthcheckTimeout": 30,
    "healthcheckInterval": 10
  },
  "env": {
    "ENVIRONMENT": "production",
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "COMPOSER_ALLOW_SUPERUSER": "1"
  }
}
