RewriteEngine on

# ============================================
# RÈGLES DE RÉÉCRITURE - TRÈS PERMISSIVES
# ============================================

# 1. Ne pas réécrire les fichiers existants (CSS, JS, images, etc.)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 2. Ne pas réécrire les dossiers existants
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3. Ne pas réécrire les ressources statiques (tous types de fichiers)
RewriteCond %{REQUEST_URI} \.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|otf|eot|mp4|webm|mp3|pdf|zip|xml|json|txt)$ [NC]
RewriteRule ^ - [L]

# 4. Réécrire tout le reste vers index.php (routes de l'application)
RewriteCond $1 !^(index\.php|install|assets|uploads|storage|vendor|system|application|resources|robots\.txt|favicon\.ico|\.well-known)
RewriteRule ^(.*)$ index.php/$1 [L,QSA]

# ============================================
# EN-TÊTES ET CONFIGURATION
# ============================================

SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# Autoriser l'indexation des dossiers (pour debug)
Options +Indexes

# Autoriser CORS pour tous les fichiers statiques
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|otf|eot|mp4|webm|mp3|json|xml)$">
        Header set Access-Control-Allow-Origin "*"
        Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
        Header set Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization"
    </FilesMatch>
    
    # Cache pour les fichiers statiques (1 mois)
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|otf|eot)$">
        Header set Cache-Control "public, max-age=2592000"
        Header set Expires "access plus 1 month"
    </FilesMatch>
</IfModule>

# ============================================
# COMPRESSION
# ============================================

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
    
    # Ne pas compresser les images et fichiers déjà compressés
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|zip|gz|bz2)$ no-gzip dont-vary
</IfModule>

# ============================================
# TYPE MIME
# ============================================

AddType text/css .css
AddType application/javascript .js
AddType image/svg+xml .svg
AddType font/woff2 .woff2
AddType font/woff .woff
AddType font/ttf .ttf
AddType font/otf .otf

# php -- BEGIN cPanel-generated handler, do not edit
# php -- END cPanel-generated handler
