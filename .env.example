# ============================================================
# ENVIRONNEMENT
# ============================================================
APP_ENV=production
APP_DEBUG=false
ENVIRONMENT=production

# ============================================================
# BASE DE DONNÉES - MODE RAILWAY/CLOUD (RECOMMANDÉ)
# ============================================================
# Railway fournit automatiquement cette variable
# Format: mysql://user:password@host:port/database
# Cette URL a la PRIORITÉ sur les variables individuelles
DATABASE_URL=mysql://user:password@localhost:3306/eshop_db

# ============================================================
# BASE DE DONNÉES - MODE LOCAL (FALLBACK)
# ============================================================
# Utilisé si DATABASE_URL n'est pas définie
# Idéal pour le développement local
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=
MYSQLDATABASE=eshop_db

# ============================================================
# APPLICATION
# ============================================================
APP_NAME=eShop
APP_URL=https://yourdomain.com
APP_TIMEZONE=UTC

# ============================================================
# LOGGING & MONITORING
# ============================================================
# Mode automatique: détecte production/development
# Production → php://stderr (Railway logs)
# Development → application/logs/ (fichiers locaux)

LOG_LEVEL=error              # error|debug|info (production: error)
LOG_THRESHOLD=1              # 0=off, 1=error, 2=debug, 3=info, 4=all
LOG_DATE_FORMAT=Y-m-d H:i:s  # Date format for logs
LOG_FILE_PERMISSIONS=0644    # Octal permissions for log files

# Force stderr logging (even in development)
# LOG_TO_STDERR=true

# Force file logging (even in production - not recommended)
# LOG_TO_FILE=true

# ============================================================
# MAIL & NOTIFICATIONS
# ============================================================
SESSION_DRIVER=database
COOKIE_NAME=eshop_session
COOKIE_SECURE=true
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=Lax

# ============================================================
# EMAIL (si utilisation de mailing)
# ============================================================
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=your_email
MAIL_PASSWORD=your_password
MAIL_FROM_ADDRESS=noreply@eshop.local
MAIL_FROM_NAME="eShop"

# ============================================================
# STOCKAGE & UPLOADS
# ============================================================
UPLOAD_PATH=public/uploads/
MAX_UPLOAD_SIZE=52428800  # 50MB en bytes

# ============================================================
# SÉCURITÉ
# ============================================================
JWT_SECRET=your-super-secret-jwt-key-change-me-in-production
API_KEY=your-api-key-change-me
ENCRYPTION_KEY=your-encryption-key-change-me

# ============================================================
# CACHE
# ============================================================
CACHE_DRIVER=file
CACHE_TTL=3600

# ============================================================
# LOGGING
# ============================================================
LOG_CHANNEL=single
LOG_LEVEL=error

# ============================================================
# PAIEMENTS (PayPal, Flutterwave, etc.)
# ============================================================
# PAYPAL_CLIENT_ID=your_client_id
# PAYPAL_SECRET=your_secret
# FLUTTERWAVE_PUBLIC_KEY=your_public_key
# FLUTTERWAVE_SECRET_KEY=your_secret_key
