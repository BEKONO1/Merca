# ============================================================
# CONFIGURATION DOCKER - Développement Local
# ============================================================
# Copier ce fichier vers .env pour tester avec Docker Compose
# cp .env.docker .env

# ============================================================
# ENVIRONNEMENT
# ============================================================
APP_ENV=development
APP_DEBUG=true
ENVIRONMENT=development

# ============================================================
# APPLICATION
# ============================================================
APP_NAME=eShop
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# ============================================================
# DATABASE - DOCKER
# ============================================================
# Format DATABASE_URL: mysql://user:password@host:port/database
# Dans docker-compose, "db" est le nom du service MySQL
DATABASE_URL=mysql://eshop_user:eshop_password@db:3306/eshop_db

# Fallback (pour compatibilité)
MYSQLHOST=db
MYSQLPORT=3306
MYSQLUSER=eshop_user
MYSQLPASSWORD=eshop_password
MYSQLDATABASE=eshop_db

# ============================================================
# MYSQL ROOT (Docker uniquement)
# ============================================================
MYSQL_ROOT_PASSWORD=rootpassword

# ============================================================
# SESSION & COOKIES
# ============================================================
SESSION_DRIVER=file
COOKIE_NAME=eshop_session
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=Lax

# ============================================================
# EMAIL (Mailtrap pour test)
# ============================================================
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=your_email
MAIL_PASSWORD=your_password
MAIL_FROM_ADDRESS=dev@eshop.local
MAIL_FROM_NAME="eShop Dev"

# ============================================================
# STOCKAGE
# ============================================================
UPLOAD_PATH=public/uploads/
MAX_UPLOAD_SIZE=52428800

# ============================================================
# SÉCURITÉ
# ============================================================
JWT_SECRET=dev-secret-key-change-in-production
API_KEY=dev-api-key-change-in-production
ENCRYPTION_KEY=dev-encryption-key-change-in-production

# ============================================================
# CACHE
# ============================================================
CACHE_DRIVER=file
CACHE_TTL=3600

# ============================================================
# LOGGING
# ============================================================
LOG_CHANNEL=single
LOG_LEVEL=debug

# ============================================================
# PAIEMENTS (Disabled in dev)
# ============================================================
# PAYPAL_CLIENT_ID=your_client_id
# PAYPAL_SECRET=your_secret
# FLUTTERWAVE_PUBLIC_KEY=your_public_key
# FLUTTERWAVE_SECRET_KEY=your_secret_key
